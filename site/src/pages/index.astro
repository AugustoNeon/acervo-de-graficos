---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GraphCard from '../components/GraphCard.astro';
import { corDaCategoria } from '../lib/categoria';

const entries = (await getCollection('graficos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [...new Set(entries.map((e) => e.data.category))].sort();

const base = import.meta.env.BASE_URL;
---

<Base title="Acervo de Gráficos" surface="board">
  <main class="mural">
    <header class="masthead">
      <span class="pin" aria-hidden="true"></span>
      <h1>Um caderno de campo sobre gráficos em R.</h1>
      <p class="intro">
        Um espécime novo de tempos em tempos — o que é, quando usar, como ler e o protocolo
        completo pra reproduzir. Organizados por categoria, como gavetas de uma coleção.
      </p>
    </header>

    <div class="filter-bar">
      <nav class="drawer-tabs" aria-label="Filtrar por categoria">
        <button type="button" class="tab is-active" data-filter="all" aria-pressed="true">
          Tudo<span>{entries.length}</span>
        </button>
        {categories.map((category) => (
          <button type="button" class="tab" data-filter={category} style={corDaCategoria(category)} aria-pressed="false">
            {category}<span>{entries.filter((e) => e.data.category === category).length}</span>
          </button>
        ))}
      </nav>
      <label class="search-label" for="search">
        <span class="visually-hidden">Buscar por título ou tag</span>
        <input type="search" id="search" placeholder="Buscar por título ou tag…" autocomplete="off" />
      </label>
    </div>
    <p class="filter-empty" id="filter-empty" hidden>Nenhum espécime bate com esse filtro/busca.</p>

    {entries.length > 0 ? (
      <div class="board-grid" id="grid">
        {entries.map((entry, i) => {
          const [category, slug] = entry.id.split('/');
          return (
            <GraphCard
              href={`${base}/graficos/${category}/${slug}/`}
              title={entry.data.title}
              category={entry.data.category}
              thumbnail={`${base}/graficos/${category}/${slug}/output.png`}
              resumo={entry.data.resumo}
              id={entry.id}
              tags={entry.data.tags}
              index={i}
              featured={i === 0}
            />
          );
        })}
      </div>
    ) : (
      <p class="note">Nenhum espécime ainda — o primeiro está a caminho.</p>
    )}

    {entries.length < 6 && (
      <p class="note">
        {entries.length} espécime{entries.length === 1 ? '' : 's'} até agora — novos entram no
        caderno aos poucos, quase todo dia.
      </p>
    )}
  </main>
</Base>

<style>
  .mural {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .masthead {
    position: relative;
    max-width: 42rem;
    margin-bottom: var(--space-xl);
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    background: var(--paper);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lift);
    transform: rotate(-0.6deg);
  }

  .pin {
    position: absolute;
    top: -0.65rem;
    left: 2.25rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, oklch(0.98 0 0), var(--color-primary) 62%, oklch(0.24 0.1 258) 100%);
    box-shadow: 0 3px 5px oklch(0.2 0.02 255 / 0.35);
  }

  h1 {
    font-size: var(--text-display);
    max-width: 16ch;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    line-height: var(--leading-snug);
  }

  .filter-bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    position: sticky;
    top: var(--space-sm);
    z-index: var(--z-sticky);
    /* Sem fundo próprio, as abas coladas no topo deixavam o card por baixo
       vazar pelos vãos entre elas (e, com 2+ linhas, pelo espaço entre
       linhas) assim que ele passava a rolar por trás -- quebra a
       ilusão de "coisa pregada num quadro". Um fundo opaco cobrindo a
       caixa inteira (não só cada aba) resolve os dois. */
    background: var(--board);
    padding: var(--space-3xs) 0;
    box-shadow: 0 6px 10px -6px oklch(0.16 0.03 55 / 0.4);
  }

  .drawer-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.35rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .search-label {
    flex: 0 0 auto;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .search-label input {
    min-height: 2.75rem;
    padding: 0.55em 0.9em;
    background: var(--paper-surface);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    width: 14rem;
  }

  .search-label input::placeholder {
    color: var(--color-ink-muted);
  }

  .filter-empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--paper);
    margin-bottom: var(--space-lg);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0.55em 0.95em 0.5em;
    background: var(--paper-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--cat, var(--color-border-strong));
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-out-expo),
      background var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo);
  }

  .tab span {
    font-size: var(--text-xs);
    opacity: 0.65;
  }

  .tab:hover {
    transform: translateY(-3px);
    color: var(--color-ink);
  }

  .tab.is-active {
    background: var(--paper);
    color: var(--cat-ink, var(--color-ink));
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .tab[data-filter='all'].is-active {
    border-top-color: var(--color-primary);
    color: var(--color-primary);
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-xl) var(--space-lg);
  }

  .board-grid :global(.specimen[hidden]) {
    display: none;
  }

  .note {
    color: var(--paper);
    font-size: var(--text-sm);
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
  }

  @media (max-width: 40rem) {
    .mural {
      padding: var(--space-lg) var(--space-sm) var(--space-2xl);
    }

    .masthead {
      padding: var(--space-md) var(--space-md) var(--space-lg);
    }

    .filter-bar {
      position: static;
      flex-wrap: wrap;
    }

    .search-label {
      flex: 1 1 100%;
    }

    .search-label input {
      width: 100%;
    }
  }
</style>

<script>
  const grid = document.getElementById('grid');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const emptyNote = document.getElementById('filter-empty');

  function categoriaAtiva(): string {
    return document.querySelector<HTMLButtonElement>('.tab.is-active')?.dataset.filter ?? 'all';
  }

  // Filtro de categoria e busca por texto são independentes, mas o card
  // final so aparece se passar pelos dois -- filtrar por MAP e digitar
  // "streaming" restringe dentro de MAP, nao ignora o filtro de categoria.
  function aplicarFiltros() {
    const cat = categoriaAtiva();
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visiveis = 0;
    grid?.querySelectorAll<HTMLElement>('.specimen').forEach((card) => {
      const bateCategoria = cat === 'all' || card.dataset.category === cat;
      const bateBusca = !query || (card.dataset.searchIndex ?? '').includes(query);
      const show = bateCategoria && bateBusca;
      card.hidden = !show;
      if (show) visiveis++;
    });
    if (emptyNote) emptyNote.hidden = visiveis > 0;
  }

  // O filtro/busca fica na URL (?cat=/?q=) pra sobreviver ao "voltar" de
  // dentro de um grafico e pra dar pra compartilhar uma vista filtrada --
  // sem isso, voltar de qualquer especime sempre reiniciava em "Tudo".
  // replaceState (nao pushState): cada tecla digitada ou clique de aba nao
  // deveria empilhar uma entrada nova no historico do navegador.
  function sincronizarUrl() {
    const cat = categoriaAtiva();
    const query = searchInput?.value.trim() ?? '';
    const params = new URLSearchParams();
    if (cat !== 'all') params.set('cat', cat);
    if (query) params.set('q', query);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  function restaurarDaUrl() {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('cat') ?? 'all';
    const query = params.get('q') ?? '';
    tabs.forEach((b) => {
      const active = b.dataset.filter === cat;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    if (searchInput) searchInput.value = query;
    aplicarFiltros();
  }

  tabs.forEach((button) => {
    button.addEventListener('click', () => {
      tabs.forEach((b) => {
        const active = b === button;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      aplicarFiltros();
      sincronizarUrl();
    });
  });

  searchInput?.addEventListener('input', () => {
    aplicarFiltros();
    sincronizarUrl();
  });

  restaurarDaUrl();
</script>
