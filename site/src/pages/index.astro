---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GraphCard from '../components/GraphCard.astro';
import { corDaCategoria } from '../lib/categoria';

const entries = (await getCollection('graficos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [...new Set(entries.map((e) => e.data.category))].sort();

const base = import.meta.env.BASE_URL;
---

<Base title="Acervo de Gráficos">
  <header class="masthead">
    <div class="masthead-inner">
      <h1>Um catálogo de gráficos em R, um de cada vez.</h1>
      <p class="intro">
        Um gráfico novo em R, de tempos em tempos, organizados por categoria conforme vão sendo feitos.
      </p>
    </div>
  </header>

  <main class="content">
    <nav class="filters" aria-label="Filtrar por categoria">
      <button type="button" class="filter is-active" data-filter="all">Todos<span>{entries.length}</span></button>
      {categories.map((category) => (
        <button type="button" class="filter" data-filter={category} style={corDaCategoria(category)}>
          <i class="filter-dot" aria-hidden="true"></i>
          {category}
          <span>{entries.filter((e) => e.data.category === category).length}</span>
        </button>
      ))}
    </nav>

    {entries.length > 0 ? (
      <div class="grid" id="grid">
        {entries.map((entry, i) => {
          const [category, slug] = entry.id.split('/');
          return (
            <GraphCard
              href={`${base}/graficos/${category}/${slug}/`}
              title={entry.data.title}
              category={entry.data.category}
              date={entry.data.date}
              interactive={entry.data.interactive}
              thumbnail={`${base}/graficos/${category}/${slug}/output.png`}
              resumo={entry.data.resumo}
              index={i}
            />
          );
        })}
      </div>
    ) : (
      <p class="empty">Nenhum gráfico ainda — o primeiro está a caminho.</p>
    )}

    {entries.length < 6 && (
      <p class="coming-soon">
        {entries.length} gráfico{entries.length === 1 ? '' : 's'} até agora — novos chegam aos poucos, quase todo dia.
      </p>
    )}
  </main>
</Base>

<style>
  .masthead {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2xl) var(--space-md) var(--space-xl);
  }

  .masthead-inner {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  h1 {
    font-size: var(--text-display);
    max-width: 18ch;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    line-height: var(--leading-snug);
  }

  .content {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-lg);
    position: sticky;
    top: 0;
    background: color-mix(in oklch, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(6px);
    padding-block: var(--space-sm);
    z-index: var(--z-sticky);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.5em 0.9em;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-muted);
    transition: background var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
  }

  /* O ponto é a cor viva da categoria; o rótulo fica em texto legível. Assim o
     filtro usa exatamente o mesmo par de sinais do card, e a correspondência
     entre chip e grade se lê sem precisar de rótulo extra. */
  .filter-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--cat);
    flex: none;
  }

  .filter span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: inherit;
    opacity: 0.7;
  }

  .filter:hover {
    border-color: var(--cat, var(--color-border-strong));
    color: var(--color-ink);
  }

  .filter.is-active {
    background: var(--cat-wash);
    border-color: var(--cat);
    color: var(--cat-ink);
  }

  .filter.is-active .filter-dot {
    background: var(--cat-ink);
  }

  /* "Todos" não é categoria nenhuma, então não empresta matiz de ninguém. */
  .filter[data-filter='all'].is-active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-primary-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg) var(--space-md);
  }

  .grid :global(.card[hidden]) {
    display: none;
  }

  .empty,
  .coming-soon {
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-lg);
  }

  @media (max-width: 40rem) {
    .masthead {
      padding: var(--space-xl) var(--space-sm) var(--space-lg);
    }
  }
</style>

<script>
  const grid = document.getElementById('grid');
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.filter;
      filters.forEach((b) => b.classList.toggle('is-active', b === button));
      grid?.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        const show = target === 'all' || card.dataset.category === target;
        card.hidden = !show;
      });
    });
  });
</script>
