---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GraphCard from '../components/GraphCard.astro';
import { corDaCategoria } from '../lib/categoria';

const entries = (await getCollection('graficos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [...new Set(entries.map((e) => e.data.category))].sort();

const base = import.meta.env.BASE_URL;
---

<Base title="Acervo de Gráficos" surface="board">
  <main class="mural">
    <header class="masthead">
      <span class="pin" aria-hidden="true"></span>
      <h1>Um caderno de campo sobre gráficos em R.</h1>
      <p class="intro">
        Um espécime novo de tempos em tempos — o que é, quando usar, como ler e o protocolo
        completo pra reproduzir. Organizados por categoria, como gavetas de uma coleção.
      </p>
    </header>

    <nav class="drawer-tabs" aria-label="Filtrar por categoria">
      <button type="button" class="tab is-active" data-filter="all" aria-pressed="true">
        Tudo<span>{entries.length}</span>
      </button>
      {categories.map((category) => (
        <button type="button" class="tab" data-filter={category} style={corDaCategoria(category)} aria-pressed="false">
          {category}<span>{entries.filter((e) => e.data.category === category).length}</span>
        </button>
      ))}
    </nav>

    {entries.length > 0 ? (
      <div class="board-grid" id="grid">
        {entries.map((entry, i) => {
          const [category, slug] = entry.id.split('/');
          return (
            <GraphCard
              href={`${base}/graficos/${category}/${slug}/`}
              title={entry.data.title}
              category={entry.data.category}
              thumbnail={`${base}/graficos/${category}/${slug}/output.png`}
              resumo={entry.data.resumo}
              id={entry.id}
              index={i}
              featured={i === 0}
            />
          );
        })}
      </div>
    ) : (
      <p class="note">Nenhum espécime ainda — o primeiro está a caminho.</p>
    )}

    {entries.length < 6 && (
      <p class="note">
        {entries.length} espécime{entries.length === 1 ? '' : 's'} até agora — novos entram no
        caderno aos poucos, quase todo dia.
      </p>
    )}
  </main>
</Base>

<style>
  .mural {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-md) var(--space-3xl);
  }

  .masthead {
    position: relative;
    max-width: 42rem;
    margin-bottom: var(--space-xl);
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    background: var(--paper);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lift);
    transform: rotate(-0.6deg);
  }

  .pin {
    position: absolute;
    top: -0.65rem;
    left: 2.25rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, oklch(0.98 0 0), var(--color-primary) 62%, oklch(0.24 0.1 258) 100%);
    box-shadow: 0 3px 5px oklch(0.2 0.02 255 / 0.35);
  }

  h1 {
    font-size: var(--text-display);
    max-width: 16ch;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .intro {
    margin-top: var(--space-md);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    line-height: var(--leading-snug);
  }

  .drawer-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.35rem;
    margin-bottom: var(--space-xl);
    position: sticky;
    top: var(--space-sm);
    z-index: var(--z-sticky);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 0.95em 0.5em;
    background: var(--paper-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--cat, var(--color-border-strong));
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-fast) var(--ease-out-expo),
      background var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo);
  }

  .tab span {
    font-size: var(--text-xs);
    opacity: 0.65;
  }

  .tab:hover {
    transform: translateY(-3px);
    color: var(--color-ink);
  }

  .tab.is-active {
    background: var(--paper);
    color: var(--cat-ink, var(--color-ink));
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .tab[data-filter='all'].is-active {
    border-top-color: var(--color-primary);
    color: var(--color-primary);
  }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    grid-auto-flow: dense;
    gap: var(--space-xl) var(--space-lg);
  }

  .board-grid :global(.specimen[hidden]) {
    display: none;
  }

  .note {
    color: var(--paper);
    font-size: var(--text-sm);
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
  }

  @media (max-width: 40rem) {
    .mural {
      padding: var(--space-lg) var(--space-sm) var(--space-2xl);
    }

    .masthead {
      padding: var(--space-md) var(--space-md) var(--space-lg);
    }

    .drawer-tabs {
      position: static;
    }
  }
</style>

<script>
  const grid = document.getElementById('grid');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');

  tabs.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.filter;
      tabs.forEach((b) => {
        const active = b === button;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      grid?.querySelectorAll<HTMLElement>('.specimen').forEach((card) => {
        const show = target === 'all' || card.dataset.category === target;
        card.hidden = !show;
      });
    });
  });
</script>
