---
import { formatDate } from '../lib/format';
import { corDaCategoria } from '../lib/categoria';

interface Props {
  href: string;
  title: string;
  category: string;
  date: Date;
  interactive: boolean;
  thumbnail: string;
  resumo: string;
  /** Posição na grade — só alimenta o atraso escalonado da entrada. */
  index?: number;
}

const { href, title, category, date, interactive, thumbnail, resumo, index = 0 } = Astro.props;
---

<a
  class="card"
  href={href}
  data-category={category}
  style={`${corDaCategoria(category)} --i: ${index};`}
>
  <div class="card-media">
    <img src={thumbnail} alt="" loading="lazy" decoding="async" />
    {interactive && <span class="card-badge">interativo</span>}
    <div class="card-overlay">
      <span class="card-date">{formatDate(date)}</span>
      <span class="card-cta">Ver gráfico →</span>
    </div>
  </div>
  <div class="card-body">
    <span class="card-category"><i class="card-dot" aria-hidden="true"></i>{category}</span>
    <h3 class="card-title">{title}</h3>
    <p class="card-resumo">{resumo}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-ink);
    border-radius: var(--radius-md);
    outline-offset: 4px;
  }

  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    /* O fundo do thumbnail é o lavado da categoria: os output.png têm fundo
       branco, então a cor aparece na margem em volta do gráfico — é onde dá
       pra ter área de cor sem tocar no gráfico em si. */
    background: var(--cat-wash);
    border: 1px solid var(--color-border);
    transition: border-color var(--duration-base) var(--ease-out-expo);
  }

  .card:hover .card-media,
  .card:focus-visible .card-media {
    border-color: var(--cat);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .card:hover .card-media img,
  .card:focus-visible .card-media img {
    transform: scale(1.04);
  }

  .card-badge {
    position: absolute;
    top: var(--space-2xs);
    right: var(--space-2xs);
    /* -ink, não a variante viva: é texto pequeno sobre a cor, precisa dos
       4.5:1 que só a variante escura garante. */
    background: var(--cat-ink);
    color: var(--color-primary-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    padding: 0.2em 0.55em;
    border-radius: var(--radius-sm);
  }

  .card-overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-sm);
    background: linear-gradient(to top, oklch(0.16 0.014 235 / 0.78), transparent);
    color: oklch(1 0 0);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--duration-base) var(--ease-out-expo),
      transform var(--duration-base) var(--ease-out-expo);
  }

  .card:hover .card-overlay,
  .card:focus-visible .card-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .card-cta {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .card-body {
    padding-top: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  /* O nome da categoria e o ponto ao lado são o mesmo sinal em dois pesos: a
     cor viva marca de longe (é o que se vê varrendo a grade), o texto em -ink
     confirma de perto e é o que precisa passar em contraste. */
  .card-category {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--cat-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--cat);
    flex: none;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .card-resumo {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  /* Entrada escalonada da grade.
     O card é visível por padrão — a animação é acréscimo, não o que o traz à
     tela. Se ela nunca rodar (aba em segundo plano, motor sem composição), o
     que fica é o card normal, nunca um espaço em branco. Por isso `backwards`
     e não `both`: o estado inicial só vale durante o atraso. */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      animation: card-entra var(--duration-slow) var(--ease-out-quint) backwards;
      animation-delay: calc(var(--i, 0) * 35ms);
    }
  }

  @keyframes card-entra {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-media,
    .card-media img,
    .card-overlay {
      transition: none;
    }
    .card:hover .card-media img {
      transform: none;
    }
  }
</style>
